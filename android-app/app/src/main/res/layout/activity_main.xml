<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Logo of Choice -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="TruthLens App Logo" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TruthLens"
            android:textSize="32sp"
            android:textColor="#E94560"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI vs Human Text Detection"
            android:textSize="16sp"
            android:textColor="#8899AA"
            android:layout_marginTop="8dp" />

        <!-- ===== OVERLAY SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Capture Mode"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activate to capture text from any screen"
                android:textSize="13sp"
                android:textColor="#8899AA"
                android:layout_marginTop="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnActivateOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="ACTIVATE OVERLAY"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/button_bg"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnDeactivateOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="DEACTIVATE OVERLAY"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#555555"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== DIVIDER ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--- OR ---"
            android:textSize="14sp"
            android:textColor="#556677"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- ===== MANUAL TEXT INPUT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste or type text manually"
            android:textSize="14sp"
            android:textColor="#AABBCC"
            android:layout_marginBottom="8dp" />

        <!-- Paste from Clipboard Button -->
        <Button
            android:id="@+id/btnPasteClipboard"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="PASTE FROM CLIPBOARD"
            android:textSize="13sp"
            android:textColor="#E94560"
            android:backgroundTint="#16213E"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextInput"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:hint="Enter or paste text here...\n(Minimum 20 words)"
            android:textColor="#FFFFFF"
            android:textColorHint="#556677"
            android:textSize="14sp"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/textWordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 words"
            android:textSize="12sp"
            android:textColor="#556677"
            android:textAlignment="viewEnd"
            android:layout_marginTop="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ANALYZE TEXT"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/button_bg"
            android:layout_marginTop="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VIEW HISTORY"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/button_bg"
            android:backgroundTint="#16213E"
            android:layout_marginTop="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="#E94560" />

        <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyzing text..."
            android:textSize="14sp"
            android:textColor="#8899AA"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- ===== SERVER CONFIGURATION ===== -->
        <LinearLayout
            android:id="@+id/cardServerConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backend Server Configuration"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCurrentServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current: https://truthlens-backend-0rlr.onrender.com/"
                android:textSize="13sp"
                android:textColor="#8899AA"
                android:layout_marginTop="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfigureServer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CHANGE SERVER URL"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/button_bg"
                android:backgroundTint="#16213E"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        

    </LinearLayout>
</ScrollView>
