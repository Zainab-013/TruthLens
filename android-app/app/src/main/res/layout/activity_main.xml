<?xml version="1.0" encoding="utf-8"?>
<!--
    HOME SCREEN - activity_main.xml
    Now with Activate Overlay button + Text analysis
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TruthLens"
            android:textSize="32sp"
            android:textColor="#E94560"
            android:textStyle="bold"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI vs Human Text Detection"
            android:textSize="16sp"
            android:textColor="#8899AA"
            android:layout_marginTop="8dp" />

        <!-- ===== OVERLAY SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Capture Mode"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activate to capture text from any screen"
                android:textSize="13sp"
                android:textColor="#8899AA"
                android:layout_marginTop="4dp" />

            <!-- Activate Button -->
            <Button
                android:id="@+id/btnActivateOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="ACTIVATE OVERLAY"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/button_bg"
                android:layout_marginTop="12dp" />

            <!-- Deactivate Button (hidden by default) -->
            <Button
                android:id="@+id/btnDeactivateOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="DEACTIVATE OVERLAY"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#555555"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ===== DIVIDER ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--- OR ---"
            android:textSize="14sp"
            android:textColor="#556677"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- ===== TEXT INPUT SECTION ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste text manually"
            android:textSize="14sp"
            android:textColor="#AABBCC"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextInput"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:hint="Enter or paste text here...\n(Minimum 50 words)"
            android:textColor="#FFFFFF"
            android:textColorHint="#556677"
            android:textSize="14sp"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/textWordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 words"
            android:textSize="12sp"
            android:textColor="#556677"
            android:textAlignment="viewEnd"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ANALYZE TEXT"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/button_bg"
            android:layout_marginTop="16dp" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="#E94560" />

        <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyzing text..."
            android:textSize="14sp"
            android:textColor="#8899AA"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by GPT-2 NLP Engine"
            android:textSize="11sp"
            android:textColor="#334455"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
