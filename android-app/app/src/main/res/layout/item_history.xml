<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/textSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extracted text preview goes here..."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 26, 2026 14:30"
            android:textColor="#8899AA"
            android:textSize="12sp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI: "
                android:textColor="#E94560"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAiVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92.0%"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Human: "
                android:textColor="#0FFF50"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHumanVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8.0%"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
