<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic to localhost and emulator loopback for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">172.20.23.186</domain>
        <domain includeSubdomains="true">10.148.47.109</domain>
        <domain includeSubdomains="true">172.20.21.30</domain>
    </domain-config>
    
    <!-- By default, enforce secure HTTPS traffic in production for all other hosts -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
