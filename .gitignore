# ============================================
# TruthLens - Comprehensive .gitignore
# ============================================

# -------------------- User Custon Ignores --------------------
Important Documents/
PROJECT_DOCUMENTATION.md

# -------------------- Python --------------------
# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, coverage, and analysis
.tox/
.nosexy/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------- Java / Spring Boot --------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
*.class
*.jar
*.war
*.ear
*.log
.mvn/
mvnw
mvnw.cmd

# -------------------- Android --------------------
.gradle/
local.properties
*.apk
*.ap_
*.aab
*.dex
captures/
.externalNativeBuild/
.cxx/
output.json

# -------------------- IDEs --------------------
# JetBrains / Android Studio / PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace
.history/

# Eclipse
.classpath
.project
.settings/
.factorypath

# -------------------- OS & Editor Artifacts --------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.bak
*.tmp
*.orig

# -------------------- Models & Large Files --------------------
# GPT-2 / Hugging Face cached model files
*.bin
*.safetensors
*.h5
*.pt
*.pth
.cache/
huggingface/

# -------------------- Environment & Secrets --------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# -------------------- Web / Node (if applicable) --------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*